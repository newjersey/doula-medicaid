{
  "name": "Codespaces: Documentation Preview",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts",
      "installPnpm": true
    }
  },
  "postCreateCommand": "nvm install 18.18.0 && npm install && npm run dev",
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Application"
    }
  },
  "hostRequirements": {
    "cpus": 16,
    "memory": "32gb",
    "storage": "128gb"
  }
}
