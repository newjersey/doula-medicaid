{
  "name": "doula-medicaid",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "NODE_OPTIONS='--inspect' vite --mode test",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --port 3000",
    "prettier": "prettier . --write",
    "prettier:check": "prettier . --check",
    "cypress:run": "cypress run",
    "cypress:gui": "cypress open",
    "test": "env $(cat cypress/.env.test-production-flags | xargs) vitest --run",
    "typecheck": "tsc --build",
    "configureVpc": "npx tsx scripts/configureVpc.ts",
    "cdk:deploy": "npx cdk deploy DoulaAssistantStack"
  },
  "author": {
    "name": "New Jersey State Office of Innovation",
    "url": "https://github.com/newjersey"
  },
  "dependencies": {
    "@newjersey/njwds": "2.9.0",
    "@trussworks/react-uswds": "10.2.0",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.71.1",
    "react-router": "7.12.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "3.975.0",
    "@eslint/eslintrc": "3.3.3",
    "@eslint/js": "9.39.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/gtag.js": "0.0.20",
    "@types/node": "24.10.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/parser": "8.53.1",
    "@vitejs/plugin-react": "5.1.2",
    "aws-cdk": "2.1102.0",
    "aws-cdk-lib": "2.236.0",
    "cypress": "15.9.0",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "jiti": "2.6.1",
    "jsdom": "27.4.0",
    "pdfjs-dist": "5.4.530",
    "prettier": "latest",
    "prettier-plugin-jsdoc": "1.8.0",
    "prettier-plugin-organize-imports": "latest",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
