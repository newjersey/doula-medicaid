{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // "types": ["cypress"],

    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["cypress", "vitest/globals", "@testing-library/jest-dom"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    // "allowImportingTsExtensions": true,
    // "moduleDetection": "force",
    "noEmit": true,
    // "jsx": "react-jsx",

    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@form/*": ["../src/app/form/*"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx"],
  "exclude": []
}
