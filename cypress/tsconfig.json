{
  // "extends": "../tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.cypress.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,

    "types": [
      "node",
      "vitest/globals",
      "@testing-library/jest-dom",
      "cypress"
      // ,
      // "@testing-library/dom"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@form/*": ["../src/app/form/*"]
    },

    "target": "ES2023",
    "lib": ["ES2023"],
    // "module": "ESNext",
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx"]
}
